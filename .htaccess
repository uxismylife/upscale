# Hostinger (LiteSpeed/Apache) settings for the 4K Upscaler static site.

AddType application/wasm .wasm
AddType text/plain .txt
AddDefaultCharset utf-8

# Compress text files. The base64 model (12 MB) shrinks to about 9 MB on the wire.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json application/wasm image/svg+xml
</IfModule>

# The page itself is always checked for updates; the model and engine files are cached for a month.
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(txt|json|wasm)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>

# Keep repository and tool files off the public site.
RedirectMatch 404 ^/(tools|\.git)(/|$)
<FilesMatch "^(README\.md|THIRD_PARTY_NOTICES\.md|\.gitignore)$">
  Require all denied
</FilesMatch>
